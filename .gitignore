# build artifacts
build/
*.pyc
__pycache__/

# engine (phases 3+) — Unreal
unreal/DerivedDataCache/
unreal/Intermediate/
unreal/Binaries/
unreal/Saved/
unreal/.vs/
*.uasset.tmp

# OS
.DS_Store
Thumbs.db

# staged canon copies (generated by tools/stage_canon_for_ue.py)
unreal/SchizoGame/Content/Sim/canon/

# generated art binaries (tools/art/*.py) — regenerate with the commands in
# tools/art/README.md; only art/review/ (contact sheet) and art/assets.csv
# are tracked.
art/generated/

# downloaded CC0 source textures (tools/art/fetch_textures.py) — ~100 MB,
# over the repo's commit budget; re-fetch any time, idempotent.
art/source/

# generated per machine — never tracked
kernel/build*/
kernel/Testing/
unreal/Plugins/*/Binaries/
unreal/Plugins/*/Intermediate/
.claude/
